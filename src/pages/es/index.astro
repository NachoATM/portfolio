---
// /es/ now redirects to root (Spanish is served at the base URL)
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${base}`} />
    <script is:inline define:vars={{ base }}>
      window.location.replace(base);
    </script>
  </head>
  <body></body>
</html>
