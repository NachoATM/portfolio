---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import FormacionSection from "../../components/FormacionSection.astro";
import ReposSection from "../../components/ReposSection.astro";
import EmptySection from "../../components/EmptySection.astro";
import PromptCard from "../../components/PromptCard.astro";
import ArticleCard from "../../components/ArticleCard.astro";

const lang = "en";

const proyectos = (await getCollection("proyectos")).filter(
  (p) => p.data.idioma === lang
);
const titulos = (await getCollection("titulos")).filter(
  (t) => t.data.idioma === lang
);
const certs = (await getCollection("certificaciones")).filter(
  (c) => c.data.idioma === lang
);
const repos = (await getCollection("repos")).filter(
  (r) => r.data.idioma === lang
);
const prompts = (await getCollection("prompts")).filter(
  (p) => p.data.idioma === lang
);
const articulos = (await getCollection("articulos")).filter(
  (a) => a.data.idioma === lang
);

const sortedProyectos = proyectos.sort((a, b) => {
  if (a.data.destacado && !b.data.destacado) return -1;
  if (!a.data.destacado && b.data.destacado) return 1;
  return b.data.fecha.getTime() - a.data.fecha.getTime();
});

const sortedTitulos = titulos.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const sortedCerts = certs.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
---

<Base title="Jose Ignacio Esteban González · Portfolio" lang={lang}>
  <Hero
    lang={lang}
    totalProyectos={proyectos.length}
    totalTitulos={titulos.length}
    totalCerts={certs.length}
  />

  <hr class="sep" />

  <section id="proyectos" class="section-wrap">
    <div class="section-header">
      <h2
        class="font-serif"
        style="font-size:clamp(1.4rem,2.5vw,1.9rem);letter-spacing:-.02em;color:var(--ink)"
      >
        Projects
      </h2>
      <span class="section-count">{String(proyectos.length).padStart(2, "0")}</span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.15rem">
      {
        sortedProyectos.map((p) => (
          <ProjectCard
            titulo={p.data.titulo}
            resumen={p.data.resumen}
            stack={p.data.stack}
            repo={p.data.repo}
            demo={p.data.demo}
            destacado={p.data.destacado}
            icono={p.data.icono}
            badge={p.data.badge}
          />
        ))
      }
    </div>
  </section>

  <hr class="sep" />

  <FormacionSection
    lang={lang}
    titulos={sortedTitulos.map((t) => t.data)}
    certs={sortedCerts.map((c) => c.data)}
  />

  <hr class="sep" />

  <ReposSection lang={lang} repos={repos.map((r) => r.data)} />

  <hr class="sep" />

  {
    prompts.length > 0 ? (
      <section id="prompts" class="section-wrap">
        <div class="section-header">
          <h2 class="font-serif" style="font-size:clamp(1.4rem,2.5vw,1.9rem);letter-spacing:-.02em;color:var(--ink)">
            Prompts
          </h2>
          <span class="section-count">{String(prompts.length).padStart(2, "0")}</span>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.15rem">
          {prompts.map((p) => (
            <PromptCard
              titulo={p.data.titulo}
              categoria={p.data.categoria}
              descripcion={p.data.descripcion}
              tags={p.data.tags}
              body={p.body}
              github={p.data.github}
              demo={p.data.demo}
            />
          ))}
        </div>
      </section>
    ) : (
      <EmptySection
        id="prompts"
        title="Prompts"
        message="Prompts I use in my daily workflow."
      />
    )
  }

  <hr class="sep" />

  {
    articulos.length > 0 ? (
      <section id="articulos" class="section-wrap">
        <div class="section-header">
          <h2 class="font-serif" style="font-size:clamp(1.4rem,2.5vw,1.9rem);letter-spacing:-.02em;color:var(--ink)">
            Articles
          </h2>
          <span class="section-count">{String(articulos.length).padStart(2, "0")}</span>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.15rem">
          {articulos.map((a) => (
            <ArticleCard
              titulo={a.data.titulo}
              fuente={a.data.fuente}
              fecha={a.data.fecha}
              url={a.data.url}
              resumen={a.data.resumen}
              tags={a.data.tags}
            />
          ))}
        </div>
      </section>
    ) : (
      <EmptySection
        id="articulos"
        title="Articles"
        message="Articles on AI, development and technology."
      />
    )
  }
</Base>
