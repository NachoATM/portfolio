---
interface Props {
  titulo: string;
  categoria: string;
  descripcion: string;
  tags: string[];
  body: string;
  github?: string;
  demo?: string;
}

const { titulo, categoria, descripcion, tags, body, github, demo } = Astro.props;

const categoryIcons: Record<string, string> = {
  "Data Science":     `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
  "Data Engineering": `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>`,
  "Machine Learning": `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.46 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.46 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"/></svg>`,
};
const iconHtml = categoryIcons[categoria] ?? `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`;

// Unique ID for copy button targeting
const uid = Math.random().toString(36).slice(2, 8);
---

<div class="prompt-card">
  <!-- Header -->
  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:.75rem;margin-bottom:.85rem">
    <div style="display:flex;align-items:center;gap:.6rem;min-width:0">
      <div
        style="width:34px;height:34px;background:var(--green-bg);border:1px solid color-mix(in srgb,var(--green) 20%,var(--border));border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--green-text);flex-shrink:0"
        set:html={iconHtml}
      />
      <div style="font-size:.92rem;font-weight:600;color:var(--ink);line-height:1.3">{titulo}</div>
    </div>
    <span class="badge" style="flex-shrink:0;margin-top:2px">{categoria}</span>
  </div>

  <!-- Description -->
  <p style="font-size:.82rem;color:var(--ink2);line-height:1.65;margin-bottom:.85rem">{descripcion}</p>

  <!-- Tags -->
  <div style="display:flex;flex-wrap:wrap;gap:.3rem;margin-bottom:.9rem">
    {tags.map((t) => <span class="tag">{t}</span>)}
  </div>

  <!-- Expandable full prompt -->
  <details class="prompt-details">
    <summary class="prompt-summary">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="chevron"><polyline points="6 9 12 15 18 9"/></svg>
      Ver prompt completo
    </summary>

    <div style="position:relative;margin-top:.75rem">
      <!-- Copy button -->
      <button
        class="copy-btn"
        data-target={uid}
        aria-label="Copiar prompt"
        title="Copiar"
      >
        <svg class="icon-copy" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        <svg class="icon-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
        <span class="copy-label">Copiar</span>
      </button>

      <!-- Prompt text -->
      <pre id={uid} class="prompt-body">{body.trim()}</pre>
    </div>
  </details>

  <!-- External links -->
  {(github || demo) && (
    <div style="display:flex;gap:.85rem;border-top:1px solid var(--border);padding-top:.8rem;margin-top:.8rem">
      {github && (
        <a href={github} target="_blank" rel="noopener" class="prompt-link">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.2c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          GitHub
        </a>
      )}
      {demo && (
        <a href={demo} target="_blank" rel="noopener" class="prompt-link">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
          Demo
        </a>
      )}
    </div>
  )}
</div>

<style>
  .prompt-card {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.35rem;
    transition: border-color .25s, transform .25s, box-shadow .25s;
    position: relative;
    overflow: hidden;
  }
  .prompt-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 2px;
    background: linear-gradient(to right, var(--green), var(--green-light));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .3s;
  }
  .prompt-card:hover { border-color: color-mix(in srgb,var(--green) 40%,var(--border)); transform: translateY(-2px); box-shadow: 0 8px 32px -8px rgba(30,92,64,.15); }
  .prompt-card:hover::before { transform: scaleX(1); }

  /* Details / summary */
  .prompt-details { border-top: 1px solid var(--border); padding-top: .8rem; }
  .prompt-summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: .4rem;
    font-family: "DM Mono", monospace;
    font-size: .68rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--green-text);
    cursor: pointer;
    user-select: none;
    width: fit-content;
  }
  .prompt-summary::-webkit-details-marker { display: none; }
  .prompt-summary:hover { opacity: .8; }
  .chevron { transition: transform .2s; flex-shrink: 0; }
  details[open] .chevron { transform: rotate(180deg); }

  /* Prompt text box */
  .prompt-body {
    font-family: "DM Mono", monospace;
    font-size: .72rem;
    line-height: 1.7;
    color: var(--ink2);
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem 1.1rem;
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 320px;
    overflow-y: auto;
    margin: 0;
    scrollbar-width: thin;
    scrollbar-color: var(--border2) transparent;
  }

  /* Copy button */
  .copy-btn {
    position: absolute;
    top: .5rem; right: .5rem;
    display: flex;
    align-items: center;
    gap: .3rem;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 3px 8px;
    font-family: "DM Mono", monospace;
    font-size: .62rem;
    color: var(--ink3);
    cursor: pointer;
    transition: border-color .15s, color .15s;
    z-index: 1;
  }
  .copy-btn:hover { border-color: var(--green); color: var(--green-text); }
  .copy-btn.copied { border-color: var(--green); color: var(--green-text); }

  .prompt-link {
    font-size: .73rem;
    color: var(--green-text);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: .25rem;
  }
  .prompt-link:hover { text-decoration: underline; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.dataset.target!;
      const text = document.getElementById(id)?.textContent ?? "";
      await navigator.clipboard.writeText(text);

      const labelEl = btn.querySelector<HTMLElement>(".copy-label")!;
      const iconCopy = btn.querySelector<SVGElement>(".icon-copy")!;
      const iconCheck = btn.querySelector<SVGElement>(".icon-check")!;

      labelEl.textContent = "Copiado";
      iconCopy.style.display = "none";
      iconCheck.style.display = "";
      btn.classList.add("copied");

      setTimeout(() => {
        labelEl.textContent = "Copiar";
        iconCopy.style.display = "";
        iconCheck.style.display = "none";
        btn.classList.remove("copied");
      }, 2000);
    });
  });
</script>
