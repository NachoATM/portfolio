---
interface Props {
  lang: "es" | "en";
}
const { lang } = Astro.props;

const t = {
  es: {
    projects:     "Proyectos",
    education:    "Formación",
    repos:        "Repos",
    prompts:      "Prompts",
    articles:     "Artículos",
    switchLang:   "EN",
    switchLangHref: "/en/",
  },
  en: {
    projects:     "Projects",
    education:    "Education",
    repos:        "Repos",
    prompts:      "Prompts",
    articles:     "Articles",
    switchLang:   "ES",
    switchLangHref: "/es/",
  },
}[lang];

const base = import.meta.env.BASE_URL;
---

<nav class="nav-wrap">
  <div class="nav-inner">
    <!-- Logo -->
    <a
      href={`${base}${lang}/`}
      class="font-serif"
      style="font-size:1.12rem;color:var(--ink);text-decoration:none;letter-spacing:-.02em;flex-shrink:0;transition:color .2s"
    >
      JI<span style="color:var(--green)">.</span> Esteban
    </a>

    <!-- Desktop links -->
    <ul
      class="nav-links-desktop"
      style="display:flex;gap:1.75rem;list-style:none;margin:0;padding:0"
    >
      {[
        ["#proyectos",  t.projects],
        ["#formacion",  t.education],
        ["#repos",      t.repos],
        ["#prompts",    t.prompts],
        ["#articulos",  t.articles],
      ].map(([href, label]) => (
        <li>
          <a href={href} class="nav-link">{label}</a>
        </li>
      ))}
    </ul>

    <!-- Controls -->
    <div style="display:flex;align-items:center;gap:.75rem;flex-shrink:0">
      <a
        href={`${base}${t.switchLangHref}`}
        style="font-family:'DM Mono',monospace;font-size:.68rem;background:var(--bg2);border:1px solid var(--border);padding:3px 10px;border-radius:5px;color:var(--ink2);text-decoration:none;transition:border-color .2s,color .2s"
        class="lang-toggle"
      >
        {t.switchLang}
      </a>
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme"></button>
    </div>
  </div>
</nav>

<style>
  .lang-toggle:hover {
    border-color: var(--green) !important;
    color: var(--green-text) !important;
  }
</style>

<script>
  const btn = document.getElementById("theme-toggle");
  btn?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });
</script>
