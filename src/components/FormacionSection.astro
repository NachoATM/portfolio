---
interface Titulo {
  titulo: string;
  institucion: string;
  fecha_inicio?: Date;
  fecha: Date;
  categoria: string;
}

interface Cert {
  titulo: string;
  emisor: string;
  fecha: Date;
  logo: string;
  enlace_verificacion?: string;
}

interface Props {
  lang: "es" | "en";
  titulos: Titulo[];
  certs: Cert[];
}

const { lang, titulos, certs } = Astro.props;

const t = {
  es: { section: "Formación", titulos: "Títulos académicos", certs: "Certificaciones" },
  en: { section: "Education", titulos: "Academic degrees", certs: "Certifications" },
}[lang];
---

<section id="formacion" class="section-wrap">
  <div class="section-header">
    <h2 class="font-serif" style="font-size:clamp(1.4rem,2.5vw,1.9rem);letter-spacing:-.02em;color:var(--ink)">
      {t.section}
    </h2>
  </div>

  <!-- Títulos — prominent -->
  <div style="margin-bottom:2rem">
    <p style="font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink3);margin-bottom:.85rem;padding-bottom:.5rem;border-bottom:1px dashed var(--border)">
      {t.titulos}
    </p>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem">
      {
        titulos.map((item) => (
          <div class="titulo-card">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:.5rem;margin-bottom:.5rem">
              <span style="font-size:.92rem;font-weight:600;color:var(--ink);line-height:1.3">
                {item.titulo}
              </span>
              <span style="font-family:'DM Mono',monospace;font-size:.65rem;color:var(--ink3);flex-shrink:0;margin-top:2px">
                {item.fecha_inicio && item.fecha_inicio.getFullYear() !== item.fecha.getFullYear()
                  ? `${item.fecha_inicio.getFullYear()} – ${item.fecha.getFullYear()}`
                  : item.fecha.getFullYear()}
              </span>
            </div>
            <div style="font-size:.78rem;color:var(--ink2);margin-bottom:.4rem">{item.institucion}</div>
            <span class="badge">{item.categoria}</span>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Certs — subdued -->
  <div>
    <p style="font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink3);margin-bottom:.85rem;padding-bottom:.5rem;border-bottom:1px dashed var(--border)">
      {t.certs}
    </p>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:.85rem">
      {
        certs.map((item) => (
          <div class="cert-card">
            <div style="width:36px;height:36px;border-radius:6px;background:var(--bg3);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-family:'DM Mono',monospace;font-size:.6rem;font-weight:500;color:var(--ink3);flex-shrink:0;text-align:center;line-height:1.2">
              {item.logo || item.emisor.slice(0, 3).toUpperCase()}
            </div>
            <div>
              <div style="font-size:.82rem;font-weight:500;line-height:1.3;margin-bottom:.2rem;color:var(--ink2)">
                {item.titulo}
              </div>
              <div style="font-size:.7rem;color:var(--ink3)">
                {item.emisor} · {item.fecha.getFullYear()}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
