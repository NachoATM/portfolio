---
interface Titulo {
  titulo: string;
  institucion: string;
  fecha_inicio?: Date;
  fecha: Date;
  categoria: string;
}

interface Cert {
  titulo: string;
  emisor: string;
  fecha: Date;
  logo: string;
  enlace_verificacion?: string;
}

interface Props {
  lang: "es" | "en";
  titulos: Titulo[];
  certs: Cert[];
}

const { lang, titulos, certs } = Astro.props;

const t = {
  es: { section: "Formación", titulos: "Títulos académicos", certs: "Certificaciones" },
  en: { section: "Education", titulos: "Academic degrees",   certs: "Certifications" },
}[lang];

// Inline brand logos — monochromatic, uses portfolio CSS variables
const brandLogos: Record<string, { bg: string; border: string; html: string }> = {
  "Amazon Web Services": {
    bg: "var(--bg3)",
    border: "var(--border)",
    html: `<svg viewBox="0 0 80 42" xmlns="http://www.w3.org/2000/svg" width="44" height="23">
      <text x="2" y="27" font-family="Arial Black,Arial,sans-serif" font-size="23" font-weight="900" fill="var(--green)" letter-spacing="-1">aws</text>
      <path d="M8 36 Q40 45 72 36" stroke="var(--green)" stroke-width="3.5" fill="none" stroke-linecap="round"/>
      <path d="M65 32 L72 36 L65 40" stroke="var(--green)" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`,
  },
  "MIT": {
    bg: "var(--bg3)",
    border: "var(--border)",
    html: `<svg viewBox="0 0 56 24" xmlns="http://www.w3.org/2000/svg" width="40" height="18">
      <text x="28" y="20" font-family="Arial Black,Arial,sans-serif" font-size="21" font-weight="900" fill="var(--green)" text-anchor="middle" letter-spacing="3">MIT</text>
    </svg>`,
  },
  "DataCamp": {
    bg: "var(--bg3)",
    border: "var(--border)",
    html: `<svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" width="26" height="26">
      <path d="M243.277 183.684v69.36l-74.914 41.971V141.482l74.914 42.202zm24.25 145.723V266.89l100.33-56.227-24.408-13.731-75.922 42.548v-62.726a11.971 11.971 0 00-6.089-10.33l-91.395-51.45a17.799 17.799 0 00-17.69.504c-5.112 3.149-8.22 8.66-8.209 14.592v176.303a17.144 17.144 0 008.199 14.624 17.772 17.772 0 0016.975.903l.693-.347 73.213-41.047v55.923c.021 4.273 2.352 8.22 6.12 10.351l93.958 52.354 24.407-13.742-100.182-55.997v.01z" fill="var(--green)"/>
    </svg>`,
  },
  "University of Michigan": {
    bg: "var(--bg3)",
    border: "var(--border)",
    html: `<svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" width="26" height="26">
      <text x="16" y="27" font-family="Arial Black,Arial,sans-serif" font-size="28" font-weight="900" fill="var(--green)" text-anchor="middle">M</text>
    </svg>`,
  },
};

function getBrand(emisor: string, logo: string) {
  return brandLogos[emisor] ?? brandLogos[logo] ?? null;
}
---

<section id="formacion" class="section-wrap">
  <div class="section-header reveal">
    <h2 class="font-serif" style="font-size:clamp(1.4rem,2.5vw,1.9rem);letter-spacing:-.02em;color:var(--ink)">
      {t.section}
    </h2>
  </div>

  <!-- Títulos -->
  <div style="margin-bottom:2.5rem">
    <p style="font-family:'DM Mono',monospace;font-size:.63rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink3);margin-bottom:1rem;padding-bottom:.5rem;border-bottom:1px dashed var(--border);display:flex;align-items:center;gap:.5rem">
      <span style="display:inline-block;width:14px;height:1.5px;background:var(--green);border-radius:2px;flex-shrink:0"></span>
      {t.titulos}
      <span class="section-count" style="margin-left:auto">{String(titulos.length).padStart(2,"0")}</span>
    </p>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:1.1rem">
      {titulos.map((item, i) => (
        <div class="titulo-card reveal" style={`transition-delay:${i * 60}ms`}>
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:.5rem;margin-bottom:.55rem">
            <span style="font-size:.9rem;font-weight:600;color:var(--ink);line-height:1.35">
              {item.titulo}
            </span>
            <span style="font-family:'DM Mono',monospace;font-size:.62rem;color:var(--green-text);background:var(--green-bg);padding:2px 7px;border-radius:3px;flex-shrink:0;margin-top:2px;border:1px solid color-mix(in srgb,var(--green) 15%,transparent)">
              {item.fecha_inicio && item.fecha_inicio.getFullYear() !== item.fecha.getFullYear()
                ? `${item.fecha_inicio.getFullYear()} – ${item.fecha.getFullYear()}`
                : item.fecha.getFullYear()}
            </span>
          </div>
          <div style="font-size:.78rem;color:var(--ink2);margin-bottom:.55rem;line-height:1.4">{item.institucion}</div>
          <span class="badge">{item.categoria}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Certificaciones -->
  <div>
    <p style="font-family:'DM Mono',monospace;font-size:.63rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink3);margin-bottom:1rem;padding-bottom:.5rem;border-bottom:1px dashed var(--border);display:flex;align-items:center;gap:.5rem">
      <span style="display:inline-block;width:14px;height:1.5px;background:var(--green);border-radius:2px;flex-shrink:0"></span>
      {t.certs}
      <span class="section-count" style="margin-left:auto">{String(certs.length).padStart(2,"0")}</span>
    </p>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:.9rem">
      {certs.map((item, i) => {
        const brand = getBrand(item.emisor, item.logo);
        return (
          <div class="cert-card reveal" style={`transition-delay:${i * 50}ms`}>
            {brand ? (
              <div
                class="cert-logo"
                style={`background:${brand.bg};border-color:${brand.border};`}
                set:html={brand.html}
              />
            ) : (
              <div class="cert-logo">
                {(item.logo || item.emisor.slice(0, 3)).toUpperCase()}
              </div>
            )}
            <div style="min-width:0">
              <div style="font-size:.83rem;font-weight:500;line-height:1.35;margin-bottom:.22rem;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                {item.titulo}
              </div>
              <div style="font-size:.7rem;color:var(--ink3);display:flex;align-items:center;gap:.35rem">
                {item.emisor}
                <span style="opacity:.4">·</span>
                {item.fecha.getFullYear()}
                {item.enlace_verificacion && (
                  <a
                    href={item.enlace_verificacion}
                    target="_blank"
                    rel="noopener"
                    style="color:var(--green-text);text-decoration:none;font-size:.65rem;margin-left:auto;flex-shrink:0"
                  >
                    ↗
                  </a>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
