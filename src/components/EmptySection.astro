---
interface Props {
  id: string;
  title: string;
  message: string;
}
const { id, title, message } = Astro.props;
---

<section {id} class="section-wrap">
  <div class="section-header">
    <h2 class="font-serif" style="font-size:clamp(1.4rem,2.5vw,1.9rem);letter-spacing:-.02em;color:var(--ink)">
      {title}
    </h2>
    <span class="section-count">00</span>
  </div>
  <div class="empty-state">
    <div style="font-size:1.4rem;margin-bottom:.75rem;opacity:.35">✦</div>
    <div style="font-size:.85rem;font-weight:500;color:var(--ink3);margin-bottom:.25rem">
      Próximamente
    </div>
    <div style="font-size:.75rem;color:var(--ink3);opacity:.7">{message}</div>
  </div>
</section>
