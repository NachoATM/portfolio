---
interface Props {
  lang: "es" | "en";
  totalProyectos: number;
  totalTitulos: number;
  totalCerts: number;
}

const { lang, totalProyectos, totalTitulos, totalCerts } = Astro.props;
const base = import.meta.env.BASE_URL;

const t = {
  es: {
    eyebrow:  "Portfolio · 2026",
    role1:    "AI Engineer",
    role2:    "Desarrollador de Software",
    tagline:  "Especialista en Inteligencia Artificial and Big Data. Construyendo soluciones tecnológicas de alto impacto.",
    cta1:     "Ver proyectos",
    cta2:     "Descargar CV",
    s1:       "Proyectos",
    s2:       "Títulos",
    s3:       "Certs",
  },
  en: {
    eyebrow:  "Portfolio · 2026",
    role1:    "AI Engineer",
    role2:    "Software Developer",
    tagline:  "Specialist in Artificial Intelligence and Big Data. Building high-impact technology solutions.",
    cta1:     "View projects",
    cta2:     "Download CV",
    s1:       "Projects",
    s2:       "Degrees",
    s3:       "Certs",
  },
}[lang];
---

<div class="hero-section">
  <!-- Ambient glow orbs -->
  <div class="hero-glow-1" aria-hidden="true"></div>
  <div class="hero-glow-2" aria-hidden="true"></div>

  <div class="hero-wrap">
    <div>
      <!-- Eyebrow -->
      <p
        class="hero-anim-1"
        style="font-family:'DM Mono',monospace;font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:var(--green);margin-bottom:1.25rem;display:flex;align-items:center;gap:.6rem"
      >
        <span style="display:inline-block;width:20px;height:1.5px;background:var(--green);border-radius:2px;flex-shrink:0"></span>
        {t.eyebrow}
      </p>

      <!-- Name -->
      <h1
        class="font-serif hero-anim-2"
        style="font-size:clamp(2.8rem,5.5vw,4.6rem);line-height:1.06;letter-spacing:-.03em;color:var(--ink)"
      >
        Jose Ignacio<br /><em style="color:var(--green)">{lang === "es" ? "Esteban González" : "Esteban González"}</em>
      </h1>

      <!-- Role badges -->
      <div class="hero-anim-3" style="display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.1rem">
        <span style="font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.06em;text-transform:uppercase;background:var(--green-bg);color:var(--green-text);padding:4px 10px;border-radius:5px;border:1px solid color-mix(in srgb,var(--green) 20%,transparent)">
          {t.role1}
        </span>
        <span style="font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.06em;text-transform:uppercase;background:var(--bg2);color:var(--ink3);padding:4px 10px;border-radius:5px;border:1px solid var(--border)">
          {t.role2}
        </span>
      </div>

      <!-- Tagline -->
      <p
        class="hero-anim-3"
        style="font-size:.96rem;font-weight:300;color:var(--ink2);margin-top:1.4rem;max-width:480px;line-height:1.8"
      >
        {t.tagline}
      </p>

      <!-- CTAs -->
      <div class="hero-anim-4" style="display:flex;gap:.9rem;margin-top:2.4rem;flex-wrap:wrap">
        <a href="#proyectos" class="btn-primary">
          {t.cta1}
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:.85"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href={`${base}pdfs/cv-${lang}.pdf`} download class="btn-secondary">
          {t.cta2}
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity:.7"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
        </a>
      </div>
    </div>

    <!-- Stats -->
    <div
      class="hero-stats hero-stats-anim"
      style="display:flex;flex-direction:column;gap:1.4rem;align-items:flex-end;padding-bottom:.5rem"
    >
      {[
        [totalProyectos, t.s1],
        [null, null],
        [totalTitulos, t.s2],
        [null, null],
        [totalCerts, t.s3],
      ].map(([val, label]) =>
        val === null ? (
          <div class="stat-divider" style="width:1px;height:44px;background:var(--border)"></div>
        ) : (
          <div style="text-align:right">
            <div class="font-serif" style="font-size:2.1rem;color:var(--ink);line-height:1;font-weight:400">
              {val}
            </div>
            <div style="font-family:'DM Mono',monospace;font-size:.58rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink3);margin-top:3px">
              {label}
            </div>
          </div>
        )
      )}
    </div>
  </div>
</div>
